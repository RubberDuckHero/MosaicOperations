{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "process:default",
    "core:app:allow-exit",
    {
        "identifier": "http:default",
        "allow": [
            {
                "url": "https://meridianframework.sam-morgan-sp1.workers.dev/**"
            }
        ]
    }
  ]
}
